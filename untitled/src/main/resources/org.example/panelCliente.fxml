<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="680.0" maxWidth="1100.0" prefHeight="680.0" prefWidth="1100.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.PanelClienteViewController">

    <left>
        <VBox prefWidth="260.0" spacing="18.0" styleClass="menu-lateral">
            <padding>
                <Insets bottom="25.0" left="18.0" right="18.0" top="30.0" />
            </padding>

            <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label prefHeight="30.0" prefWidth="33.0" style="-fx-font-size: 25;" styleClass="titulo-marca" text="🎬" />
      
                      <Label prefHeight="0.0" prefWidth="86.0" styleClass="titulo-marca" text="CINEMA UQ" />
               </children>
            </HBox>

                <VBox spacing="12.0">
                    <children>

                        <ToggleButton fx:id="btnCartelera" maxHeight="60.0" minHeight="60.0" onAction="#mostrarCartelera" prefHeight="60.0" prefWidth="200.0">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane maxHeight="45.0" minHeight="45.0" prefHeight="45.0" styleClass="role-i">
                                            <Label styleClass="role-icono-menu" text="🎥" />
                                        </StackPane>
                                        <Label style="-fx-font-size: 17;" styleClass="role-titulo" text="Cartelera" />
                                    </children>
                                </HBox>
                            </graphic>
                     <styleClass>
                        <String fx:value="role-card" />
                        <String fx:value="role-card-menu" />
                     </styleClass>
                        </ToggleButton>

                        <ToggleButton fx:id="btnConfiteria" maxHeight="60.0" minHeight="60.0" onAction="#mostrarConfiteria" prefWidth="200.0">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane styleClass="role-icono-menu">
                                            <Label prefHeight="14.0" prefWidth="24.0" styleClass="role-icono-texto" text="🍔" />
                                        </StackPane>
                                        <Label style="-fx-font-size: 17;" styleClass="role-titulo" text="Confitería" />
                                    </children>
                                </HBox>
                            </graphic>
                     <styleClass>
                        <String fx:value="role-card" />
                        <String fx:value="role-card-menu" />
                     </styleClass>
                        </ToggleButton>

                        <ToggleButton fx:id="btnComprar" maxHeight="60.0" minHeight="60.0" onAction="#mostrarCompra" prefWidth="200.0">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane styleClass="role-icono-menu">
                                            <Label prefHeight="2.0" prefWidth="24.0" styleClass="role-icono-texto" text="💰" />
                                        </StackPane>
                                        <Label style="-fx-font-size: 17;" styleClass="role-titulo" text="Comprar" />
                                    </children>
                                </HBox>
                            </graphic>
                     <styleClass>
                        <String fx:value="role-card" />
                        <String fx:value="role-card-menu" />
                     </styleClass>
                        </ToggleButton>

                        <ToggleButton fx:id="btnMiTarjeta" maxHeight="60.0" minHeight="60.0" onAction="#mostrarTarjeta" prefWidth="200.0">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane styleClass="role-icono-menu">
                                            <Label styleClass="role-icono-texto" text="💳" />
                                        </StackPane>
                                        <Label style="-fx-font-size: 17;" styleClass="role-titulo" text="Mi tarjeta" />
                                    </children>
                                </HBox>
                            </graphic>
                     <styleClass>
                        <String fx:value="role-card" />
                        <String fx:value="role-card-menu" />
                     </styleClass>
                        </ToggleButton>

                        <ToggleButton fx:id="btnMisPuntos" maxHeight="60.0" minHeight="60.0" onAction="#mostrarPuntos" prefWidth="200.0">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane styleClass="role-icono-menu">
                                            <Label styleClass="role-icono-texto" text="★" />
                                        </StackPane>
                                        <Label style="-fx-font-size: 17;" styleClass="role-titulo" text="Mis puntos" />
                                    </children>
                                </HBox>
                            </graphic>
                     <styleClass>
                        <String fx:value="role-card" />
                        <String fx:value="role-card-menu" />
                     </styleClass>
                        </ToggleButton>

                        <ToggleButton fx:id="btnMisCompras" maxHeight="60.0" minHeight="60.0" onAction="#mostrarCompras" prefWidth="200.0">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane styleClass="role-icono-menu">
                                            <Label styleClass="role-icono-texto" text="🛍" />
                                        </StackPane>
                                        <Label style="-fx-font-size: 17;" styleClass="role-titulo" text="Mis compras" />
                                    </children>
                                </HBox>
                            </graphic>
                     <styleClass>
                        <String fx:value="role-card" />
                        <String fx:value="role-card-menu" />
                     </styleClass>
                        </ToggleButton>

                        <ToggleButton fx:id="btnMiPerfil" maxHeight="60.0" minHeight="60.0" onAction="#mostrarPerfil" prefWidth="200.0">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane styleClass="role-icono-menu">
                                            <Label styleClass="role-icono-texto" text="👤" />
                                        </StackPane>
                                        <Label style="-fx-font-size: 17;" styleClass="role-titulo" text="Mi perfil" />
                                    </children>
                                </HBox>
                            </graphic>
                     <styleClass>
                        <String fx:value="role-card" />
                        <String fx:value="role-card-menu" />
                     </styleClass>
                        </ToggleButton>

                    </children>
                </VBox>

                <VBox VBox.vgrow="ALWAYS" />

                <Button fx:id="btnCerrarSesion" maxWidth="200.0" onAction="#cerrarSesion" style="-fx-font-size: 15;" styleClass="btn-ghost" text="Cerrar sesión" />

            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenidoDinamico" styleClass="panel-contenido">

            <children>

                <VBox fx:id="vistaBienvenida" alignment="CENTER" prefHeight="680.0" prefWidth="821.0" spacing="20.0" styleClass="bienvenida-cliente">

                    <children>

                        <Label fx:id="lblBienvenida" styleClass="titulo-grande" text="BIENVENIDO" />

                        <Label style="-fx-font-size: 22;" styleClass="portada-frase" text="Disfruta de nuestros servicios y vive la experiencia del cine" wrapText="true" />

                        <Pane />

                    </children>
                </VBox>

            </children>
        </StackPane>
    </center>

</BorderPane>
