<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="950.0" styleClass="root" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.SeleccionarAsientoViewController">

    <children>

        <VBox spacing="20.0" styleClass="cartelera-root" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>

            <Label styleClass="titulo-grande" text="SELECCIÓN DE ASIENTOS" />

            <HBox alignment="CENTER_LEFT" spacing="10.0">

                <Label fx:id="lblFuncion" styleClass="subtitulo" text="Selecciona tus asientos" />

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="lblCantidadEntradas" style="-fx-font-size: 15;" styleClass="form-label" text="Entradas: 0" />

            </HBox>

            <VBox spacing="12.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                <Label alignment="CENTER" maxWidth="Infinity" styleClass="subtitulo" text="PANTALLA" />

                <Region prefHeight="8.0" styleClass="separador-cartelera" />

                <GridPane fx:id="gridAsientos" alignment="CENTER" hgap="9.0" vgap="10.0" VBox.vgrow="ALWAYS">

                    <columnConstraints>
                        <ColumnConstraints minWidth="30.0" prefWidth="35.0" />
                    </columnConstraints>

                </GridPane>

                <HBox alignment="CENTER" spacing="25.0">

                    <HBox alignment="CENTER" spacing="7.0">
                        <Region prefHeight="16.0" prefWidth="16.0" styleClass="asiento-disponible" />
                        <Label styleClass="texto-sec" text="Disponible" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="7.0">
                        <Region prefHeight="16.0" prefWidth="16.0" styleClass="asiento-seleccionado" />
                        <Label styleClass="texto-sec" text="Seleccionado" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="7.0">
                        <Region prefHeight="16.0" prefWidth="16.0" styleClass="asiento-ocupado" />
                        <Label styleClass="texto-sec" text="Ocupado" />
                    </HBox>

                </HBox>

            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0">

                <Label fx:id="lblCantidadSeleccionada" style="-fx-font-size: 15;" styleClass="form-label" text="Asientos seleccionados: 0" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnCancelar" onAction="#cancelarSeleccion" prefWidth="150.0" styleClass="btn-ghost" text="CANCELAR" />

                <Button fx:id="btnAceptar" onAction="#aceptarSeleccion" prefWidth="170.0" styleClass="btn-primary" text="ACEPTAR" />

            </HBox>

        </VBox>

    </children>

</AnchorPane>
