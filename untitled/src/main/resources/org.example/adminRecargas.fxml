<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.RecargasAdminViewController">
    <children>
        <VBox spacing="16.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="24.0">
            <padding>
                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="3.0" />
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT" spacing="5.0">
                        <Label fx:id="lblTotalSolicitudes" styleClass="funcion-formato" text="0 solicitudes pendientes" />
                        <Label styleClass="form-label" text="TOTAL SOLICITADO" />
                        <Label fx:id="lblMontoTotal" styleClass="combo-precio" text="COP 0" />
                    </VBox>
                </HBox>

                <HBox spacing="16.0" VBox.vgrow="ALWAYS">
                    <VBox minWidth="625.0" prefWidth="710.0" spacing="10.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="10.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Solicitudes pendientes" />
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtBuscar" maxWidth="290.0" promptText="Buscar por cliente, identificación o tarjeta" styleClass="login-input" />
                                <Button mnemonicParsing="false" onAction="#limpiarBusqueda" styleClass="btn-ghost" text="LIMPIAR" />
                            </HBox>
                            <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colCliente" prefWidth="145.0" text="Cliente" />
                                    <TableColumn fx:id="colIdentificacion" prefWidth="105.0" text="Identificación" />
                                    <TableColumn fx:id="colTarjeta" prefWidth="112.0" text="Tarjeta" />
                                    <TableColumn fx:id="colMonto" prefWidth="110.0" text="Monto solicitado" />
                                    <TableColumn fx:id="colMetodo" prefWidth="125.0" text="Método de pago" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <placeholder>
                                    <Label styleClass="texto-sec" text="No hay solicitudes de recarga pendientes." />
                                </placeholder>
                            </TableView>
                            <Label styleClass="texto-sec" text="Selecciona una solicitud para consultar los datos de la tarjeta y decidir si la apruebas o rechazas." wrapText="true" />
                        </VBox>
                    </VBox>

                    <VBox minWidth="340.0" prefWidth="365.0" spacing="12.0">
                        <VBox spacing="12.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">
                            <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Detalle de la solicitud" />
                            <VBox spacing="4.0">
                                <Label styleClass="form-label" text="CLIENTE" />
                                <Label fx:id="lblNombreDetalle" styleClass="texto-sec" text="—" />
                                <Label fx:id="lblIdentificacionDetalle" styleClass="texto-sec" text="—" />
                            </VBox>
                            <Region styleClass="separador-cartelera" />
                            <VBox spacing="4.0">
                                <Label styleClass="form-label" text="NÚMERO DE TARJETA" />
                                <Label fx:id="lblTarjetaDetalle" styleClass="texto-sec" text="—" />
                            </VBox>
                            <HBox spacing="12.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="SALDO ACTUAL" />
                                    <Label fx:id="lblSaldoActual" styleClass="texto-sec" text="—" />
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="ESTADO TARJETA" />
                                    <Label fx:id="lblEstadoTarjeta" styleClass="texto-sec" text="—" />
                                </VBox>
                            </HBox>
                            <Region styleClass="separador-cartelera" />
                            <VBox spacing="4.0">
                                <Label styleClass="form-label" text="MONTO DE LA RECARGA" />
                                <Label fx:id="lblMontoSolicitado" styleClass="combo-precio" text="—" />
                            </VBox>
                            <VBox spacing="4.0">
                                <Label styleClass="form-label" text="MÉTODO DE PAGO SELECCIONADO" />
                                <Label fx:id="lblMetodoPago" styleClass="texto-sec" text="—" />
                            </VBox>
                        </VBox>

                        <VBox spacing="10.0" styleClass="cartelera-card">
                            <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Gestionar solicitud" />
                            <Button fx:id="btnAprobar" maxWidth="Infinity" mnemonicParsing="false" onAction="#aprobarSolicitud" styleClass="btn-primary" text="APROBAR RECARGA" />
                            <Button fx:id="btnRechazar" maxWidth="Infinity" mnemonicParsing="false" onAction="#rechazarSolicitud" styleClass="btn-ghost" text="RECHAZAR SOLICITUD" />
                        </VBox>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
