<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.ComprasViewController">

    <children>

        <VBox spacing="20.0" AnchorPane.bottomAnchor="28.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="28.0">

            <children>

                <VBox spacing="12.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                    <children>

                        <HBox alignment="CENTER" spacing="10.0">
                            <Label style="-fx-font-size: 33;" styleClass="titulo-grande" text="Historial de compras" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblCantidadCompras" styleClass="texto-sec" text="0 compras" />
                        </HBox>

                        <TableView fx:id="tablaCompras" prefHeight="340.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código" />
                                <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha" />
                                <TableColumn fx:id="colEntradas" prefWidth="250.0" text="Entradas" />
                                <TableColumn fx:id="colConsumibles" prefWidth="250.0" text="Confitería" />
                                <TableColumn fx:id="colTotal" prefWidth="150.0" text="Total" />
                                <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
                            </columns>

                        </TableView>

                        <Label fx:id="lblSeleccion" styleClass="form-label" text="SELECCIONA UNA COMPRA PARA VER SUS DETALLES" />

                        <VBox fx:id="contenedorDetalles" spacing="14.0" styleClass="detalle-compra">

                            <children>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label style="-fx-font-size: 33;" styleClass="titulo-grande" text="Detalle de la compra" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblCodigoDetalle" styleClass="funcion-formato" />
                                </HBox>

                                <HBox spacing="30.0">

                                    <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="FECHA DE COMPRA" />
                                        <Label fx:id="lblFechaDetalle" styleClass="texto-sec" />
                                    </VBox>

                                    <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="CANTIDAD DE ENTRADAS" />
                                        <Label fx:id="lblEntradasDetalle" styleClass="texto-sec" />
                                    </VBox>

                                    <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="PUNTOS OBTENIDOS" />
                                        <Label fx:id="lblPuntosDetalle" styleClass="texto-sec" />
                                    </VBox>

                                    <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="ESTADO" />
                                        <Label fx:id="lblEstadoDetalle" styleClass="texto-sec" />
                                    </VBox>

                                </HBox>

                                <Region styleClass="separador-cartelera" />

                                <VBox spacing="6.0">
                                    <Label styleClass="form-label" text="ENTRADAS" />
                                    <Label fx:id="lblDetalleEntradas" styleClass="texto-sec" wrapText="true" />
                                </VBox>

                                <VBox spacing="6.0">
                                    <Label styleClass="form-label" text="CONFITERÍA" />
                                    <Label fx:id="lblDetalleConsumibles" styleClass="texto-sec" wrapText="true" />
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <Button fx:id="btnSolicitarReembolso" mnemonicParsing="false" onAction="#solicitarReembolso" prefHeight="39.0" prefWidth="209.0" styleClass="btn-primary" text="SOLICITAR REEMBOLSO" />
                                    <Label styleClass="form-label" text="TOTAL PAGADO" />
                                    <Label fx:id="lblTotalDetalle" styleClass="pelicula-titulo" />
                                </HBox>

                            </children>

                        </VBox>

                    </children>

                </VBox>

            </children>

        </VBox>

    </children>

</AnchorPane>
