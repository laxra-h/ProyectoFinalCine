<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" styleClass="root" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.CompraViewController">

    <children>

        <VBox spacing="18.0" styleClass="cartelera-root" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <HBox spacing="18.0" VBox.vgrow="ALWAYS">

                <VBox maxHeight="750.0" maxWidth="440.0" minHeight="750.0" minWidth="440.0" prefHeight="750.0" prefWidth="440.0" spacing="16.0" styleClass="cartelera-card" HBox.hgrow="ALWAYS">

                    <Label style="-fx-font-size: 33;" styleClass="titulo-grande" text="PELÍCULA Y FUNCIÓN" />

                    <Label style="-fx-font-size: 16;" styleClass="form-label" text="Selecciona una película" />

                    <ComboBox fx:id="cbPeliculas" maxWidth="409.0" minWidth="409.0" prefWidth="409.0" promptText="Seleccionar película" styleClass="compra-combo" />

                    <Label style="-fx-font-size: 16;" styleClass="form-label" text="Selecciona una función" />

                    <ComboBox fx:id="cbFunciones" maxWidth="409.0" minWidth="409.0" prefWidth="409.0" promptText="Seleccionar función" styleClass="compra-combo" />

                    <Label style="-fx-font-size: 16;" styleClass="form-label" text="Cantidad de entradas" />

                    <Spinner fx:id="spCantidadEntradas" editable="true" prefWidth="130.0" styleClass="compra-spinner" />

                    <Region VBox.vgrow="ALWAYS" />

                    <Label fx:id="lblAsientosSeleccionados" styleClass="texto-sec" text="No has seleccionado asientos" wrapText="true" />

                    <Button fx:id="btnSeleccionarAsientos" maxWidth="Infinity" styleClass="btn-primary" text="SELECCIONAR ASIENTOS" />

                </VBox>

                <VBox prefWidth="430.0" spacing="16.0" HBox.hgrow="ALWAYS">

                    <VBox maxHeight="363.0" maxWidth="630.0" minHeight="363.0" minWidth="630.0" prefHeight="363.0" prefWidth="630.0" spacing="12.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                        <Label style="-fx-font-size: 33;" styleClass="titulo-grande" text="CONFITERÍA" />

                        <ListView fx:id="listaConfiteria" styleClass="confiteria-list"
                                  VBox.vgrow="ALWAYS" />

                    </VBox>

                    <VBox maxHeight="371.0" maxWidth="630.0" minHeight="371.0" minWidth="630.0" prefHeight="371.0" prefWidth="630.0" spacing="12.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                        <Label style="-fx-font-size: 20;" styleClass="titulo-grande" text="PAGO Y PUNTOS" />

                        <HBox>
                            <Label styleClass="texto-sec" text="Entradas:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblSubtotalEntradas" text="COP 0" />
                        </HBox>

                        <HBox>
                            <Label styleClass="texto-sec" text="Confitería:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblSubtotalConfiteria" text="COP 0" />
                        </HBox>

                        <Region styleClass="separador-cartelera" />

                        <HBox>
                            <Label styleClass="form-label" text="Subtotal:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblSubtotal" styleClass="form-label" text="COP 0" />
                        </HBox>

                        <Label fx:id="lblPuntosDisponibles" styleClass="texto-sec" text="Puntos disponibles: 0" />

                        <CheckBox fx:id="chkUsarPuntos" text="Quiero utilizar mis puntos" />

                        <HBox>
                            <Label styleClass="texto-sec" text="Descuento por puntos:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblDescuentoPuntos" text="COP 0" />
                        </HBox>

                        <HBox>
                            <Label styleClass="texto-sec" text="Puntos que ganarás:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblPuntosGanados" text="0" />
                        </HBox>

                        <Region styleClass="separador-cartelera" />

                        <HBox>
                            <Label styleClass="subtitulo" text="TOTAL A PAGAR" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTotalPagar" styleClass="subtitulo" text="COP 0" />
                        </HBox>

                        <Button fx:id="btnConfirmarCompra" maxWidth="Infinity" styleClass="btn-acento" text="CONFIRMAR COMPRA" />

                    </VBox>

                </VBox>

            </HBox>

        </VBox>

    </children>

</AnchorPane>
