<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.PromocionesAdminViewController">
    <children>
        <VBox spacing="16.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="24.0">
            <children>

                <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                    <VBox minWidth="365.0" prefWidth="365.0" spacing="14.0">
                        <VBox maxHeight="744.0" prefHeight="744.0" spacing="30.0" styleClass="cartelera-card">
                            <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Datos de la promoción" />

                            <VBox spacing="5.0">
                                <Label styleClass="form-label" text="NOMBRE" />
                                <TextField fx:id="txtNombre" promptText="Ej. Martes de cine" styleClass="login-input" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="form-label" text="DESCRIPCIÓN" />
                                <TextField fx:id="txtDescripcion" promptText="Describe las condiciones de la promoción" styleClass="login-input" />
                            </VBox>

                            <HBox spacing="9.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="APLICA A" />
                                    <ComboBox fx:id="cbTipo" maxWidth="Infinity" promptText="Selecciona el alcance" styleClass="compra-combo" />
                                </VBox>
                                <VBox prefWidth="118.0" spacing="5.0">
                                    <Label styleClass="form-label" text="DESCUENTO (%)" />
                                    <TextField fx:id="txtPorcentaje" promptText="20" styleClass="login-input" />
                                </VBox>
                            </HBox>

                            <HBox spacing="9.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="FECHA DE INICIO" />
                                    <DatePicker fx:id="dpFechaInicio" maxWidth="Infinity" promptText="Desde" styleClass="compra-combo" />
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="FECHA DE FINALIZACIÓN" />
                                    <DatePicker fx:id="dpFechaFin" maxWidth="Infinity" promptText="Hasta" styleClass="compra-combo" />
                                </VBox>
                            </HBox>

                            <CheckBox fx:id="chkActiva" selected="true" text="Promoción habilitada" />

                            <HBox alignment="CENTER" spacing="15.0">
                                <Button fx:id="btnCrear" onAction="#crearPromocion" style="-fx-padding: 10 13;" styleClass="btn-primary" text="CREAR" />
                                <Button fx:id="btnActualizar" onAction="#actualizarPromocion" style="-fx-padding: 10 13;" styleClass="btn-acento" text="ACTUALIZAR" />
                                <Button fx:id="btnEliminar" onAction="#eliminarPromocion" style="-fx-padding: 10 13;" styleClass="btn-ghost" text="ELIMINAR" />
                            </HBox>
                            <Button fx:id="btnLimpiar" onAction="#limpiarFormulario" styleClass="btn-ghost" text="LIMPIAR FORMULARIO" />
                            <Label fx:id="lblMensaje" minHeight="34.0" styleClass="mensaje-exito" text="Registra una promoción o selecciona una de la tabla para editarla." wrapText="true" />
                        </VBox>
                    </VBox>

                    <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="8.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Promociones registradas" />
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtBuscar" maxWidth="260.0" promptText="Buscar por nombre, tipo o estado" styleClass="login-input" />
                            </HBox>
                            <TableView fx:id="tablaPromociones" minHeight="500.0" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNombre" prefWidth="165.0" text="Nombre" />
                                    <TableColumn fx:id="colTipo" prefWidth="115.0" text="Aplica a" />
                                    <TableColumn fx:id="colDescuento" prefWidth="95.0" text="Descuento" />
                                    <TableColumn fx:id="colVigencia" prefWidth="190.0" text="Vigencia" />
                                    <TableColumn fx:id="colEstado" prefWidth="105.0" text="Estado" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <placeholder>
                                    <Label styleClass="texto-sec" text="Todavía no hay promociones registradas." />
                                </placeholder>
                            </TableView>
                            <Label styleClass="texto-sec" text="Selecciona una promoción para modificar sus datos, fechas o estado." wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>
            </children>
            <padding>
                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
