<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.ConfiteriaAdminViewController">
    <children>
        <VBox spacing="16.0" AnchorPane.bottomAnchor="28.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="28.0">
            <children>

                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Productos">
                            <content>
                                <HBox spacing="18.0" style="-fx-padding: 18 4 4 4;">
                                    <children>
                                        <VBox minWidth="350.0" prefWidth="350.0" spacing="20.0" styleClass="cartelera-card">
                                            <children>
                                                <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Datos del producto" />
                                                <VBox spacing="5.0">
                                                    <Label styleClass="form-label" text="NOMBRE" />
                                                    <TextField fx:id="txtProductoNombre" maxWidth="Infinity" promptText="Ej. Gaseosa" styleClass="login-input" />
                                                </VBox>
                                                <VBox spacing="5.0">
                                                    <Label styleClass="form-label" text="DESCRIPCIÓN" />
                                                    <TextField fx:id="txtProductoDescripcion" maxWidth="Infinity" promptText="Descripción del producto" styleClass="login-input" />
                                                </VBox>
                                                <HBox spacing="10.0">
                                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="form-label" text="PRECIO (COP)" />
                                                        <TextField fx:id="txtProductoPrecio" maxWidth="Infinity" promptText="7000" styleClass="login-input" />
                                                    </VBox>
                                                    <VBox minWidth="105.0" prefWidth="105.0" spacing="5.0">
                                                        <Label styleClass="form-label" text="PUNTOS" />
                                                        <TextField fx:id="txtProductoPuntos" maxWidth="Infinity" promptText="35" styleClass="login-input" />
                                                    </VBox>
                                                </HBox>
                                                <HBox alignment="CENTER" spacing="20.0">
                                                    <Button fx:id="btnCrearProducto" onAction="#crearProducto" style="-fx-padding: 10 13;" styleClass="btn-primary" text="CREAR" />
                                                    <Button fx:id="btnActualizarProducto" onAction="#actualizarProducto" style="-fx-padding: 10 13;" styleClass="btn-acento" text="ACTUALIZAR" />
                                                </HBox>
                                                <HBox alignment="CENTER" spacing="20.0">
                                                    <Button fx:id="btnEliminarProducto" onAction="#eliminarProducto" style="-fx-padding: 10 13; -fx-text-fill: #ff6666; -fx-border-color: #ff6666;" styleClass="btn-ghost" text="ELIMINAR" />
                                                    <Button fx:id="btnLimpiarProducto" onAction="#limpiarProducto" style="-fx-padding: 10 13;" styleClass="btn-ghost" text="LIMPIAR" />
                                                </HBox>
                                                <Label fx:id="lblMensajeProducto" styleClass="mensaje-exito" text="Formulario listo para registrar un producto." wrapText="true" />
                                                <Label styleClass="texto-sec" text="Un producto utilizado en uno o más combos no se puede eliminar hasta retirarlo de esos combos." wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" styleClass="cartelera-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Productos registrados" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label fx:id="lblTotalProductos" styleClass="funcion-formato" text="0 productos" />
                                                </HBox>
                                                <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colProductoNombre" text="Nombre" />
                                                        <TableColumn fx:id="colProductoDescripcion" text="Descripción" />
                                                        <TableColumn fx:id="colProductoPrecio" text="Precio" />
                                                        <TableColumn fx:id="colProductoPuntos" text="Puntos" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                    <placeholder>
                                                        <Label styleClass="texto-sec" text="No hay productos registrados." />
                                                    </placeholder>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </content>
                        </Tab>

                        <Tab text="Combos">
                            <content>
                                <HBox spacing="18.0" style="-fx-padding: 18 4 4 4;">
                                    <children>
                                        <VBox minWidth="385.0" prefWidth="385.0" spacing="10.0" styleClass="cartelera-card">
                                            <children>
                                                <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Datos del combo" />
                                                <VBox spacing="5.0">
                                                    <Label styleClass="form-label" text="NOMBRE" />
                                                    <TextField fx:id="txtComboNombre" maxWidth="Infinity" promptText="Ej. Familiar" styleClass="login-input" />
                                                </VBox>
                                                <VBox spacing="5.0">
                                                    <Label styleClass="form-label" text="DESCRIPCIÓN" />
                                                    <TextField fx:id="txtComboDescripcion" maxWidth="Infinity" promptText="Descripción del combo" styleClass="login-input" />
                                                </VBox>
                                                <VBox spacing="5.0">
                                                    <Label styleClass="form-label" text="AGREGAR PRODUCTO O COMBO" />
                                                    <HBox spacing="7.0">
                                                        <ComboBox fx:id="cbComponente" maxWidth="Infinity" promptText="Seleccionar componente" styleClass="compra-combo" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnAgregarComponente" onAction="#agregarComponente" style="-fx-padding: 9 12;" styleClass="btn-acento" text="AÑADIR" />
                                                    </HBox>
                                                </VBox>
                                                <Label styleClass="form-label" text="COMPONENTES DEL COMBO" />
                                                <ListView fx:id="listaComponentes" prefHeight="165.0" styleClass="confiteria-list" VBox.vgrow="ALWAYS" />
                                                <Button fx:id="btnQuitarComponente" maxWidth="Infinity" onAction="#quitarComponente" style="-fx-padding: 8 12;" styleClass="btn-ghost" text="RETIRAR COMPONENTE SELECCIONADO" />
                                                <HBox spacing="12.0">
                                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="form-label" text="PRECIO CALCULADO" />
                                                        <Label fx:id="lblPrecioCombo" styleClass="combo-precio" text="0" />
                                                    </VBox>
                                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                                        <Label styleClass="form-label" text="PUNTOS CALCULADOS" />
                                                        <Label fx:id="lblPuntosCombo" styleClass="combo-precio" text="0 pts" />
                                                    </VBox>
                                                </HBox>
                                                <HBox alignment="CENTER" spacing="20.0">
                                                    <Button fx:id="btnCrearCombo" onAction="#crearCombo" style="-fx-padding: 10 13;" styleClass="btn-primary" text="CREAR" />
                                                    <Button fx:id="btnActualizarCombo" onAction="#actualizarCombo" style="-fx-padding: 10 13;" styleClass="btn-acento" text="ACTUALIZAR" />
                                                </HBox>
                                                <HBox alignment="CENTER" spacing="20.0">
                                                    <Button fx:id="btnEliminarCombo" onAction="#eliminarCombo" style="-fx-padding: 10 13; -fx-text-fill: #ff6666; -fx-border-color: #ff6666;" styleClass="btn-ghost" text="ELIMINAR" />
                                                    <Button fx:id="btnLimpiarCombo" onAction="#limpiarCombo" style="-fx-padding: 10 13;" styleClass="btn-ghost" text="LIMPIAR" />
                                                </HBox>
                                                <Label fx:id="lblMensajeCombo" styleClass="mensaje-exito" text="Formulario listo para registrar un combo." wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" styleClass="cartelera-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="Combos registrados" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label fx:id="lblTotalCombos" styleClass="funcion-formato" text="0 combos" />
                                                </HBox>
                                                <TableView fx:id="tablaCombos" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colComboNombre" maxWidth="160.0" minWidth="160.0" prefWidth="160.0" text="Nombre" />
                                                        <TableColumn fx:id="colComboDescripcion" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="Descripción" />
                                                        <TableColumn fx:id="colComboContenido" maxWidth="200.0" minWidth="200.0" prefWidth="200.0" text="Componentes" />
                                                        <TableColumn fx:id="colComboPrecio" maxWidth="80.0" minWidth="80.0" text="Precio" />
                                                        <TableColumn fx:id="colComboPuntos" maxWidth="80.0" minWidth="80.0" text="Puntos" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                    <placeholder>
                                                        <Label styleClass="texto-sec" text="No hay combos registrados." />
                                                    </placeholder>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
