<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580.0" prefWidth="650.0" styleClass="root" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.OpcionesClienteViewController">

    <children>
        <VBox alignment="CENTER" prefHeight="580.0" prefWidth="650.0" spacing="22.0" styleClass="login-container">

            <padding>
                <Insets bottom="35.0" left="75.0" right="75.0" top="40.0" />
            </padding>

            <Label styleClass="titulo-marca" text="CINEMA UQ" />

            <Label alignment="CENTER" prefHeight="58.0" prefWidth="471.0" style="-fx-font-size: 50;" styleClass="titulo-grande" text="BIENVENIDO" textAlignment="CENTER" wrapText="true" />
         <Label alignment="CENTER" prefHeight="58.0" prefWidth="471.0" style="-fx-font-size: 50;" styleClass="titulo-grande" text="CLIENTE" textAlignment="CENTER" wrapText="true" />

            <Label style="-fx-font-size: 25;" styleClass="portada-frase" text="¿Qué deseas hacer?" />

            <VBox alignment="CENTER" fillWidth="true" spacing="18.0">

                <Button fx:id="btnIniciarSesion" onAction="#abrirLogin" prefHeight="105.0" prefWidth="475.0" styleClass="role-card">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <StackPane prefHeight="55.0" prefWidth="55.0" styleClass="role-icono">
                                <Label styleClass="role-icono-texto" text="♟" />
                            </StackPane>
                            <Label styleClass="role-titulo" text="Iniciar sesión" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnRegistrarse" onAction="#abrirRegistro" prefHeight="105.0" prefWidth="475.0" styleClass="role-card">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <StackPane prefHeight="55.0" prefWidth="55.0" styleClass="role-icono">
                                <Label styleClass="role-icono-texto" text="+" />
                            </StackPane>
                            <Label styleClass="role-titulo" text="Registrarse" />
                        </HBox>
                    </graphic>
                </Button>

            </VBox>

            <HBox alignment="CENTER">
                <Button fx:id="btnVolver" onAction="#volver" prefHeight="42.0" prefWidth="130.0" style="-fx-font-size: 16;" styleClass="btn-ghost" text="Volver" />
            </HBox>

        </VBox>
    </children>

</AnchorPane>
