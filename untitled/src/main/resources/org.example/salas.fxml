<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.SalasViewController">

    <children>

        <VBox spacing="16.0" AnchorPane.bottomAnchor="28.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="28.0">

            <children>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <VBox maxWidth="480.0" minWidth="480.0" prefWidth="480.0" spacing="16.0">

                        <VBox spacing="12.0" styleClass="cartelera-card">

                            <Label style="-fx-font-size: 25;" styleClass="titulo-grande" text="Datos de la sala" />

                            <VBox spacing="6.0">
                                <Label styleClass="form-label" text="NÚMERO O NOMBRE DE LA SALA" />
                                <TextField fx:id="txtNumeroSala" maxWidth="Infinity" promptText="Ej: Sala 4" styleClass="login-input" />
                            </VBox>

                            <HBox spacing="24.0">
         
                                <Label fx:id="lblTotalSalas" alignment="TOP_LEFT" styleClass="funcion-formato" text="0 salas" />
                                <VBox spacing="4.0">
                                    <Label styleClass="form-label" text="CAPACIDAD" />
                                    <Label fx:id="lblCapacidad" style="-fx-font-size: 18;" styleClass="combo-precio" text="-" />
                                </VBox>
                                <VBox spacing="4.0">
                                    <Label styleClass="form-label" text="DISTRIBUCIÓN" />
                                    <Label fx:id="lblDistribucion" style="-fx-font-size: 18;" styleClass="combo-precio" text="-" />
                                </VBox>
                                <VBox spacing="4.0">
                                    <Label styleClass="form-label" text="FUNCIONES" />
                                    <Label fx:id="lblFunciones" style="-fx-font-size: 18;" styleClass="combo-precio" text="-" />
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER" spacing="15.0">
                                <Button fx:id="btnCrear" mnemonicParsing="false" onAction="#crearSala" style="-fx-padding: 10 14;" styleClass="btn-primary" text="CREAR" />
                                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarSala" style="-fx-padding: 10 14;" styleClass="btn-acento" text="ACTUALIZAR" />
                                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarSala" style="-fx-padding: 10 14;" styleClass="btn-ghost" text="ELIMINAR" />
                                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarFormulario" style="-fx-padding: 10 14;" styleClass="btn-ghost" text="LIMPIAR" />
                            </HBox>

                            <Label fx:id="lblMensaje" styleClass="mensaje-exito" wrapText="true" />

                        </VBox>

                        <VBox alignment="TOP_CENTER" spacing="9.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                            <Label maxWidth="Infinity" style="-fx-font-size: 25;" styleClass="titulo-grande" text="Estado de los asientos" />
                            <Label fx:id="lblSalaSeleccionada" maxWidth="Infinity" styleClass="texto-sec" text="Selecciona una sala y después una función para consultar sus asientos." wrapText="true" />

                            <Region maxWidth="300.0" prefHeight="5.0" style="-fx-background-color: #D9B26F; -fx-background-radius: 4px;" />
                            <Label styleClass="texto-sec" text="PANTALLA" />

                            <GridPane fx:id="gridAsientos" alignment="CENTER" hgap="3.0" maxWidth="Infinity" vgap="3.0" />

                            <HBox alignment="CENTER" spacing="18.0">
                                <HBox alignment="CENTER" spacing="6.0">
                                    <Circle fill="#49316F" radius="5.0" />
                                    <Label styleClass="texto-sec" text="Disponible" />
                                </HBox>
                                <HBox alignment="CENTER" spacing="6.0">
                                    <Circle fill="#454545" radius="5.0" />
                                    <Label styleClass="texto-sec" text="Ocupado" />
                                </HBox>
                            </HBox>

                            <HBox alignment="CENTER" spacing="20.0">
                                <Label fx:id="lblAsientosDisponibles" styleClass="funcion-formato" text="Disponibles: -" />
                                <Label fx:id="lblAsientosOcupados" styleClass="funcion-formato" text="Ocupados: -" />
                            </HBox>

                            <Label maxWidth="Infinity" styleClass="texto-sec" text="La ocupación se consulta por función, no por sala, porque los asientos pueden estar reservados en funciones diferentes." wrapText="true" />

                        </VBox>

                    </VBox>

                    <VBox spacing="16.0" HBox.hgrow="ALWAYS">

                        <VBox spacing="10.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                            <Label style="-fx-font-size: 25;" styleClass="titulo-grande" text="Salas registradas" />

                            <TableView fx:id="tablaSalas" minHeight="220.0" VBox.vgrow="ALWAYS">

                                <columns>
                                    <TableColumn fx:id="colNumeroSala" text="Sala" />
                                    <TableColumn fx:id="colCapacidad" text="Capacidad" />
                                    <TableColumn fx:id="colDistribucion" text="Distribución" />
                                    <TableColumn fx:id="colFunciones" text="Funciones" />
                                </columns>

                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>

                                <placeholder>
                                    <Label styleClass="texto-sec" text="Todavía no hay salas registradas." />
                                </placeholder>

                            </TableView>

                        </VBox>

                        <VBox spacing="10.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                            <Label style="-fx-font-size: 25;" styleClass="titulo-grande" text="Funciones de la sala seleccionada" />
                            <Label styleClass="texto-sec" text="Selecciona una función de esta tabla para visualizar sus asientos." wrapText="true" />

                            <TableView fx:id="tablaFunciones" minHeight="220.0" VBox.vgrow="ALWAYS">

                                <columns>
                                    <TableColumn fx:id="colFuncionCodigo" text="Código" />
                                    <TableColumn fx:id="colFuncionPelicula" text="Película" />
                                    <TableColumn fx:id="colFuncionFecha" text="Fecha y hora" />
                                    <TableColumn fx:id="colFuncionFormato" text="Formato" />
                                    <TableColumn fx:id="colFuncionEstado" text="Estado" />
                                </columns>

                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>

                                <placeholder>
                                    <Label styleClass="texto-sec" text="Selecciona una sala para consultar sus funciones." />
                                </placeholder>

                            </TableView>

                        </VBox>

                    </VBox>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>
