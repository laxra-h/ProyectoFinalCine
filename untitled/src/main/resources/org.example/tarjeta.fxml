<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.TarjetaViewController">

    <children>

        <VBox spacing="20.0" AnchorPane.bottomAnchor="28.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="28.0">

            <children>

                <VBox spacing="18.0" styleClass="cartelera-card" VBox.vgrow="ALWAYS">

                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label style="-fx-font-size: 33;" styleClass="titulo-grande" text="Mi tarjeta virtual" />

                            <Region HBox.hgrow="ALWAYS" />

                            <Label fx:id="lblEstadoTarjeta" styleClass="funcion-formato" text="ACTIVA" />
                        </HBox>

                        <HBox maxWidth="1050.0" minWidth="1050.0" spacing="20.0">

                            <VBox maxWidth="510.0" minWidth="510.0" spacing="35.0" styleClass="detalle-compra" HBox.hgrow="ALWAYS">

                                <Label styleClass="pelicula-titulo" text="Información de la tarjeta" />

                                <VBox spacing="10.0">
                                    <Label style="-fx-font-size: 16;" styleClass="form-label" text="NÚMERO DE TARJETA" />
                                    <Label fx:id="lblNumeroTarjeta" style="-fx-font-size: 14;" styleClass="texto-sec" text="•••• •••• •••• ••••" />
                                </VBox>

                                <VBox spacing="10.0">
                                    <Label style="-fx-font-size: 16;" styleClass="form-label" text="SALDO DISPONIBLE" />
                                    <Label fx:id="lblSaldo" styleClass="combo-precio" text="COP 0" />
                                </VBox>

                            </VBox>

                            <VBox maxWidth="510.0" minWidth="510.0" spacing="12.0" styleClass="detalle-compra" HBox.hgrow="ALWAYS">

                                <Label styleClass="pelicula-titulo" text="Solicitar recarga" />

                                <VBox spacing="6.0">
                                    <Label styleClass="form-label" text="MONTO DE RECARGA" />

                                    <TextField fx:id="txtMontoRecarga" promptText="Ingresa el monto" />
                                </VBox>

                                <VBox spacing="6.0">
                                    <Label styleClass="form-label" text="MÉTODO DE PAGO" />

                                    <ComboBox fx:id="cbMetodoPago" maxWidth="476.0" styleClass="compra-combo" promptText="Selecciona un método" />
                                </VBox>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">

                                    <Button fx:id="btnSolicitarRecarga" mnemonicParsing="false" onAction="#solicitarRecarga" styleClass="btn-primary" text="SOLICITAR RECARGA" />

                                </HBox>

                                <Label fx:id="lblEstadoSolicitud" styleClass="texto-sec" text="No tienes solicitudes pendientes." wrapText="true" />

                                <Label fx:id="lblMensajeRecarga" styleClass="mensaje-exito" wrapText="true" />

                            </VBox>

                        </HBox>

                        <Label fx:id="lblTituloHistorial" style="-fx-font-size: 33;" styleClass="titulo-grande" text="Historial de movimientos" />

                        <TableView fx:id="tablaMovimientos" prefHeight="300.0" VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />

                                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />

                                <TableColumn fx:id="colDescripcion" prefWidth="480.0" text="Descripción" />

                                <TableColumn fx:id="colMonto" prefWidth="180.0" text="Monto" />

                            </columns>

                            <placeholder>
                                <Label styleClass="texto-sec" text="Todavía no hay movimientos registrados." />
                            </placeholder>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </VBox>

    </children>

</AnchorPane>
