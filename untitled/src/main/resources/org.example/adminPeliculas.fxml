<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" styleClass="root" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.PeliculasViewController">
    <children>
        <VBox maxHeight="Infinity" maxWidth="Infinity" spacing="16.0" styleClass="card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox spacing="5.0" />

                <HBox spacing="16.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox minWidth="300.0" prefWidth="340.0" spacing="9.0" styleClass="detalle-compra">
                            <children>
                                <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="DATOS DE LA PELÍCULA" />

                                <Label styleClass="form-label" text="Nombre" />
                                <TextField fx:id="txtNombre" promptText="Nombre de la película" styleClass="login-input" />

                                <Label styleClass="form-label" text="Director" />
                                <TextField fx:id="txtDirector" promptText="Nombre del director" styleClass="login-input" />

                                <Label styleClass="form-label" text="Descripción" />
                                <TextArea fx:id="txtDescripcion" prefRowCount="5" promptText="Sinopsis de la película" styleClass="login-input" wrapText="true" />

                                <Label styleClass="form-label" text="Género" />
                                <ComboBox fx:id="cbGenero" maxWidth="306.0" prefHeight="38.0" promptText="Selecciona un género" styleClass="compra-combo" />

                                <Label styleClass="form-label" text="Clasificación" />
                                <ComboBox fx:id="cbClasificacion" maxWidth="306.0" prefHeight="38.0" promptText="Selecciona una clasificación" styleClass="compra-combo" />

                                <Label styleClass="form-label" text="Duración (minutos)" />
                                <Spinner fx:id="spDuracion" editable="false" maxWidth="306.0" prefHeight="38.0" styleClass="compra-spinner" />

                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button onAction="#crearPelicula" styleClass="btn-primary" text="Crear" />
                                        <Button fx:id="btnActualizar" onAction="#actualizarPelicula" styleClass="btn-acento" text="Actualizar" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER" prefWidth="306.0" spacing="20.0">
                                    <children>
                                        <Button fx:id="btnEliminar" onAction="#eliminarPelicula" styleClass="btn-ghost" text="Eliminar" />
                                        <Button onAction="#limpiarFormulario" styleClass="btn-ghost" text="Limpiar" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblMensaje" minHeight="36.0" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" styleClass="detalle-compra" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-size: 23;" styleClass="titulo-grande" text="PELÍCULAS REGISTRADAS" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#refrescarPeliculas" styleClass="btn-ghost" text="Actualizar lista" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaPeliculas" prefHeight="600.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colNombre" prefWidth="190.0" text="Nombre" />
                                        <TableColumn fx:id="colDirector" prefWidth="135.0" text="Director" />
                                        <TableColumn fx:id="colGenero" prefWidth="115.0" text="Género" />
                                        <TableColumn fx:id="colClasificacion" prefWidth="145.0" text="Clasificación" />
                                        <TableColumn fx:id="colDuracion" prefWidth="85.0" text="Duración" />
                                    </columns>
                                    <placeholder>
                                        <Label text="No hay películas registradas." />
                                    </placeholder>
                                </TableView>
                                <Label styleClass="texto-sec" text="Selecciona una película de la tabla para cargar sus datos en el formulario." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
